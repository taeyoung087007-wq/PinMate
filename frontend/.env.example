# 프론트엔드 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. (.env 는 git 에 커밋되지 않습니다)

# NAVER 지도 Client ID (NCP 콘솔 > Maps > Web Dynamic Map 에서 발급)
# 콘솔의 "웹 서비스 URL"에 http://localhost:5173 을 등록해야 로컬에서 동작합니다
VITE_NAVER_MAP_KEY=

# 배포 시 API 서버 주소가 다를 때만 지정 (개발 중에는 Vite 프록시가 /api 를 8080으로 넘김)
# VITE_API_URL=https://api.example.com/api
