# 프론트엔드 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. (.env 는 git 에 커밋되지 않습니다)

# 카카오 지도 JavaScript 키
VITE_KAKAO_MAP_KEY=

# ODsay 웹(URI) 키 (대중교통 길찾기. lab.odsay.com > 애플리케이션 등록 > URI 에 http://localhost:5173 등록)
# 등록한 도메인에서만 동작하므로 브라우저에 노출돼도 된다
VITE_ODSAY_API_KEY=

# 배포 도메인 (공유 미리보기 og:image 의 절대 URL 앞부분). 로컬은 비워 두면 상대 경로로 동작
VITE_PUBLIC_URL=

# 개발·배포 모두 같은 출처의 /api 사용 (Vite / Vercel 프록시가 백엔드로 전달)
VITE_API_URL=/api

# Vercel 프로젝트에만 입력. /api 없는 Render HTTPS 주소이며 브라우저에 노출되지 않음
# BACKEND_ORIGIN=https://YOUR-RENDER-SERVICE.onrender.com
