# 프론트엔드 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. (.env 는 git 에 커밋되지 않습니다)

# 카카오 지도 JavaScript 키
VITE_KAKAO_MAP_KEY=

# ODsay 웹(URI) 키 (대중교통 길찾기. lab.odsay.com > 애플리케이션 등록 > URI 에 http://localhost:5173 등록)
# 등록한 도메인에서만 동작하므로 브라우저에 노출돼도 된다
VITE_ODSAY_API_KEY=

# 배포 시 API 서버 주소가 다를 때만 지정 (개발 중에는 Vite 프록시가 /api 를 8080으로 넘김)
# VITE_API_URL=https://api.example.com/api
