#!/bin/sh
#
# main 브랜치로 직접 push 하는 것을 막는다.
# 모든 작업은 브랜치를 따서 PR로 올린다.
#
# 설치 (각자 PC에서 1회):
#   git config core.hooksPath .githooks
#
# 끄고 싶으면:
#   git config --unset core.hooksPath

protected_ref="refs/heads/main"

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # refs/heads/main 이외에도, 브랜치 삭제(local_sha 가 0)는 통과시킨다
  if [ "$remote_ref" = "$protected_ref" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo "" >&2
  echo "  ✋ main 브랜치로 직접 push 할 수 없습니다." >&2
  echo "" >&2
  echo "  브랜치를 따서 PR로 올려주세요." >&2
  echo "    git switch -c fix/작업이름" >&2
  echo "    git push -u origin fix/작업이름" >&2
  echo "" >&2
  echo "  부득이하게 올려야 한다면: git push --no-verify" >&2
  echo "" >&2
  exit 1
fi

exit 0
