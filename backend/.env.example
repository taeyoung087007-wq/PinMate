# 백엔드 로컬 환경변수 예시 (.env 로 복사 후 사용)
# Supabase DB 비밀번호 (팀원에게 전달받은 비밀번호를 입력하세요)
DB_PASSWORD=
# 서비스 가입 코드 (가입 화면에서 입력하는 코드. 팀 초대 코드와는 별개, 비어 있으면 가입 불가)
PINMATE_SIGNUP_CODE=
# 카카오 REST API 키 (길찾기용)
KAKAO_REST_API_KEY=
# TMAP 앱 키 (도보 길찾기. openapi.sk.com > 앱 생성 > TMAP API 사용 신청)
TMAP_APP_KEY=
# 공공데이터포털 인증키 Decoding 값 (실시간 버스 도착·위치. data.go.kr > 국토교통부 TAGO 버스도착정보·버스위치정보 활용 신청)
TAGO_SERVICE_KEY=
